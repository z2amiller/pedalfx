	)
	(text "[Optional] Can connect to LFO/etc to drive a second LED\non a daughterboard that supports it.  Active High."
		(exclude_from_sim no)
		(at 226.06 61.976 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
