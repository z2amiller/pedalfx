	(footprint "Backpack_Pedal:Wart_ChargePump_v1"
		(layer "F.Cu")
		(uuid "d75eb162-f8f4-4060-8841-21e427f10f7c")
		(at 128 68.1 180)
		(descr "Mating pattern for the -9VA charge-pump wart on the bypass backpack (back-FullBypassBackpack J6/J7 bridge): two 1x03 headers 16.5 mm apart (P: +9VA GND NC, N: -9VA GND NC), pin 3 mechanical only, wart outline 20.75 x 11.75 mm on Fab with a 1 mm NW chamfer (the wart's orientation key, mirrored to silk so it prints on the host board), rule area WART_KEEPOUT for the 'Over4mm' DRC class (underside ~4 mm). Also the wart board's own connector + outline template (no mirror).")
		(tags "wart mezzanine charge pump -9V pin header 1x03 pedal backpack")
