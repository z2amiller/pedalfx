	(text "CD4047B astable = drop-in for MN3102 (same pin roles as MN3102 DIP-8):\nOX1 = RC common (4047 p3), OX2 = R-drive (p2), OX3 = C-drive (p1)\nSelf-osc: R from OX2 to OX1, C from OX3 to OX1;  f_CP = 1/(4.4 R C), Q/~Q 50% duty\nCurrent-driven hosts (Julia/Caesar): OX2 open, C OX3-OX1, LFO current into OX1\nVGG_OUT = VDD*15/16 (~14/15 VDD) for BBD VGG pin (MN3207 p4)"
		(exclude_from_sim no)
		(at 127 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e0200fb6-2b1d-48df-882e-3773109d1be1")
